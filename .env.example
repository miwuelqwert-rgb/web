# Servidor
NODE_ENV=production
PORT=3000

# Base de datos MySQL compatible
DATABASE_URL=mysql://usuario:password@localhost:3306/colectionschile

# Acceso privado por enlace. Cambia este valor antes de compartir el link.
CATALOG_ACCESS_TOKEN=cambia-esta-clave-por-una-larga-y-secreta

# Autenticación Manus OAuth y almacenamiento Manus
MANUS_PROJECT_ID=tu_project_id
MANUS_JWT_SECRET=tu_jwt_secret
MANUS_OAUTH_API_URL=https://oauth.manus.im
MANUS_API_URL=https://api.manus.im
MANUS_API_KEY=tu_api_key
OWNER_OPEN_ID=tu_open_id_de_manus
